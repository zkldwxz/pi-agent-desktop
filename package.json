    "highlight.js": "^11.12.0",
    "iconoir-react": "^7.12.1",
    "liveline": "^0.0.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
