{
  "name": "pi-agent-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for the existing Pi coding agent — sessions, streaming chat, and conversation management.",
  "author": "Wwc1122121",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:web": "node --test scripts/web-regression.mjs",
    "smoke:web": "node scripts/web-smoke.mjs",
    "test:tools": "node scripts/tool-policy-regression.mjs && node scripts/cache-usage-regression.mjs",
    "test:models": "node --test scripts/model-manager-regression.mjs",
    "test:agent-team": "node scripts/agent-team-regression.mjs && node scripts/agent-team-integration.mjs",
    "icon": "node scripts/make-icon.mjs",
    "pack": "npm run icon && electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@vscode/codicons": "^0.0.46-24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "highlight.js": "^11.12.0",
    "iconoir-react": "^7.12.1",
    "liveline": "^0.0.7",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadow-plugin": "^2.1.0",
    "typebox": "^1.3.31"
  },
  "devDependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.pi.agent.desktop",
    "productName": "Pi Agent Desktop",
    "copyright": "Copyright © 2026 Wwc1122121",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/skills",
        "to": "skills"
      },
      {
        "from": "resources/extensions",
        "to": "extensions"
      }
    ],
    "asar": false,
    "npmRebuild": false,
    "afterPack": "scripts/prune-node-modules.mjs",
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Pi-Agent-Desktop-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pi Agent Desktop",
      "deleteAppDataOnUninstall": false
    }
  }
}
